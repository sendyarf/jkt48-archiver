# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.
# Next.js memuat file ini otomatis, jadi restart aplikasi setelah mengubahnya.

# Wajib: path ABSOLUT database bot. Jangan pakai nilai relatif agar web dan bot
# tidak menunjuk file database yang berbeda ketika dijalankan dari folder lain.
DB_PATH=/var/lib/jkt48/jkt48_live.db

# Wajib: secret acak minimal 32 karakter. Tanpa ini login admin dinonaktifkan
# dan halaman publik tidak bisa dipublikasikan isinya.
# Buat dengan: openssl rand -hex 32
ADMIN_SECRET=

# WAJIB: origin tepat pengunjung, tanpa trailing slash.
# Login admin DITOLAK (403) bila tidak sama persis. Tidak ada fallback yang bisa
# diandalkan di belakang proxy (Next.js mengabaikan header Host).
# Contoh: https://jkt48.vidx.download
APP_ORIGIN=

# Berapa jam setelah live selesai sebuah rekaman otomatis tampil di halaman
# publik. Default 72. Isi 0 untuk mematikan dan mewajibkan persetujuan admin
# untuk setiap rekaman.
#
# Override admin selalu menang: menekan "Terbitkan" atau "Tarik publikasi" di
# /admin/publications akan mengunci keputusan itu, dan aturan otomatis tidak
# akan menimpanya.
#
# Waktu acuan = kapan rekaman SELESAI (download_ended_at), dihitung UTC.
AUTO_PUBLISH_AFTER_HOURS=72
# Username bot Telegram publik (tanpa @) untuk tombol Download via Bot Telegram.
# Harus diawali NEXT_PUBLIC_ agar tersedia di browser.
NEXT_PUBLIC_REPLAY_BOT_USERNAME=
