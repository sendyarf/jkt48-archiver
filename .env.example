# ─── Telegram (Telethon Userbot) ────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+6281234567890

# Target channel ID (negative number for channels, e.g. -1001234567890)
# To find it: forward a message from the channel to @userinfobot
TELEGRAM_CHANNEL_ID=-1001234567890

# StringSession (for headless VPS — generate with: python -m bot.gen_session)
# Leave empty if you want interactive login (not recommended for VPS)
TELEGRAM_SESSION_STRING=

# Optional Admin Chat ID for error alerts
ADMIN_CHAT_ID=

# ─── Telegram Admin Bot (BotFather) ─────────────────────────────────────────
# Token from @BotFather — lets you manage channels from Telegram:
#   /list  /info  /add  /stop  /resume  /remove  /sethls  /live  /status
# Create a bot: open @BotFather → /newbot → copy the token here.
# Then send /start to your bot from the admin account (ADMIN_CHAT_ID).
TELEGRAM_BOT_TOKEN=

# Extra admin chat IDs allowed to control the bot (comma separated).
# ADMIN_CHAT_ID is always allowed automatically.
# TELEGRAM_ADMIN_IDS=

# Run the admin bot listener inside the main bot process (true/false)
ADMIN_BOT_ENABLED=true

# ─── Upload Target Configuration ────────────────────────────────────────────
# Destination: "telegram" (default) or "youtube"
# - telegram: uploads video file directly to Telegram channel (split into parts if > 2GB)
# - youtube: uploads unlisted to YouTube pool and sends text link to Telegram channel
UPLOAD_TARGET=telegram

# Max video size in MB before splitting for Telegram (default: 1950 MB, safe for 2GB account limit)
TELEGRAM_MAX_FILE_SIZE_MB=1950

# ─── YouTube Multi-Channel Pool ─────────────────────────────────────────────
# Channel 1 (Primary)
YT_CHANNEL_1_LABEL=Channel Utama
YT_CHANNEL_1_TOKEN=youtube_token.json
YT_CHANNEL_1_SECRET=client_secret.json

# Channel 2 (Backup - uncomment and add if you want multi-channel quota distribution)
# YT_CHANNEL_2_LABEL=Channel Backup
# YT_CHANNEL_2_TOKEN=youtube_token_ch2.json
# YT_CHANNEL_2_SECRET=client_secret_ch2.json

# Your website player base URL — DIHAPUS.
# Fitur tautan "Watch on Web" pada notifikasi Telegram sudah dihilangkan, jadi
# variabel YOUTUBE_PLAYER_BASE_URL tidak lagi dibaca. Notifikasi Telegram kini
# hanya memuat tautan YouTube.

# ─── Zona Waktu ─────────────────────────────────────────────────────────────
# Waktu SELALU disimpan sebagai UTC (dengan penanda zona waktu), sehingga nilai
# di database sama di server mana pun — termasuk VPS Seoul (UTC+9).
# Variabel di bawah hanya mengatur TAMPILAN: caption Telegram, judul/deskripsi
# YouTube, dan log status.
#
# Offset zona waktu penonton terhadap UTC: 7 = WIB, 8 = WITA, 9 = WIT.
DISPLAY_TIMEZONE_OFFSET_HOURS=7
DISPLAY_TIMEZONE_LABEL=WIB

# HANYA untuk baris database LAMA yang waktunya belum punya penanda zona waktu.
# Nilai naif dianggap UTC kecuali offset di sini diisi dengan offset server lama
# (mis. 8 bila server lama memakai WITA). Baris baru selalu UTC sehingga
# pengaturan ini tidak memengaruhinya.
LEGACY_NAIVE_TIME_OFFSET_HOURS=0

# ─── Bot Behaviour ──────────────────────────────────────────────────────────
# Path to file containing specific member usernames to monitor (one per line)
MEMBERS_FILE=members.txt

# How often to check HLS stream status (seconds)
HLS_CHECK_INTERVAL_SECONDS=15

# How long to wait after live disconnects for reconnection before merging & uploading (seconds)
# Default: 3600 (1 hour) — batas ATAS; upload bisa lebih cepat lewat idle/IDN di bawah
MERGE_WINDOW_SECONDS=3600

# Finalize lebih cepat bila HLS sudah offline & idle selama N detik.
# 0 (DEFAULT) = nonaktif — selalu tunggu MERGE_WINDOW_SECONDS penuh.
#
# ️ JANGAN dinaikkan tanpa alasan: bukti nyata live jkt48_daisy (13 Sep 2026)
# menunjukkan reconnect BISA lebih dari 50 menit:
#   haii-260913192155 (19:21) -> haii-260913201248 (20:12) -> haii-260913201503 (20:15)
# Kalau ambang ini lebih kecil dari jeda reconnect terpanjang, SATU live akan
# terpecah menjadi beberapa video.
MERGE_IDLE_FINALIZE_SECONDS=0

# Pisahkan video bila JUDUL live berubah (indikasi live baru).
# DEFAULT false = NONAKTIF, dan itu yang direkomendasikan:
#   - jkt48_carissa (15 Sep 2026) mengedit JUDUL 3x dalam satu live (4 slug, jeda 1-8
#     menit) → kalau fitur ini aktif, satu live jadi 3 video.
#   - jkt48_daisy (13 Sep 2026) reconnect dengan JUDUL SAMA tapi slug baru (jeda 51 menit).
# Jadi slug maupun judul BUKAN penentu "live baru"; penentu andal = jeda waktu
# (MERGE_WINDOW_SECONDS). Aktifkan hanya kalau Anda yakin member tidak pernah
# mengedit judul di tengah live.
MERGE_SPLIT_ON_TITLE_CHANGE=false

# Hard cap: finalize paksa merge group setelah N jam (anti stream "hang" tanpa disconnect)
MERGE_MAX_GROUP_HOURS=6


# ----- Showroom (OPSIONAL, default NONAKTIF) -----
# Selama SHOWROOM_ENABLED=false, bot berjalan PERSIS seperti sebelumnya (jalur
# Showroom tidak pernah dijalankan). Aktifkan hanya setelah Fase 2 selesai dan
# room sudah di-seed: python3 -m bot.seed_showroom
SHOWROOM_ENABLED=false

# Interval probe Showroom dipisah dari HLS_CHECK_INTERVAL_SECONDS (5 detik) untuk
# menghindari rate-limit API Showroom. 30 detik masih jauh lebih cepat daripada
# durasi live.
SHOWROOM_CHECK_INTERVAL_SECONDS=30
SHOWROOM_CONCURRENCY=10
SHOWROOM_TIMEOUT_SECONDS=8

# Berapa pembacaan offline BERTURUT-TURUT sebelum sinyal offline dianggap sah.
# Hanya memperlambat finalisasi, tidak pernah mempercepat.
SHOWROOM_OFFLINE_CONFIRMATIONS=3

# Sumber daftar room untuk seed.
SHOWROOM_ROOMS_FILE=showroom_rooms.json

# ----- Catatan untuk website (web/.env) -----
# web/.env punya DB_PATH sendiri dan WAJIB absolut, mis.
#   DB_PATH=/home/USER/jkt48-live/jkt48_live.db
# supaya bot dan web memakai berkas database yang SAMA. Bila berbeda, website
# akan tampak kosong tanpa pesan error apa pun.
# Lihat deploy/README.md untuk langkah deploy domain.

# Interval pengecekan ulang ketika finalize ditunda (mis. member masih live)
MERGE_DEFER_SECONDS=300

# ─── IDN Lookup (OPSIONAL) ──────────────────────────────────────────────────
# Dipakai hanya untuk membedakan "reconnect" vs "live baru" (butuh slug sesi IDN)
# dan mengambil judul live. Bot tetap berfungsi penuh dengan HLS saja.
# Set false kalau server IDN sedang bermasalah (banyak member live / server down).
IDN_LOOKUP_ENABLED=true
IDN_LOOKUP_TIMEOUT_SECONDS=8
IDN_LOOKUP_CACHE_SECONDS=30

# Waktu maksimal menunggu rekaman aktif selesai saat bot dihentikan (pm2 restart)
# supaya segmen parsial tidak hilang.
GRACEFUL_SHUTDOWN_SECONDS=25

# Local directory for temporary video storage on VPS
DOWNLOAD_DIR=/tmp/jkt48-lives

# SQLite database file path
DB_PATH=jkt48_live.db

# Delete local file from VPS after successful upload? (true/false)
AUTO_DELETE_AFTER_UPLOAD=true
