# ─── Telegram (Telethon Userbot) ────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+6281234567890

# Target channel ID (negative number for channels, e.g. -1001234567890)
# To find it: forward a message from the channel to @userinfobot
TELEGRAM_CHANNEL_ID=-1001234567890

# StringSession (for headless VPS — generate with: python -m bot.gen_session)
# Leave empty if you want interactive login (not recommended for VPS)
TELEGRAM_SESSION_STRING=

# Admin Chat ID for error alerts + admin bot access (WAJIB bila ADMIN_BOT_ENABLED).
# Tanpa ini, admin bot menolak berjalan (fail-closed) dan notifikasi error tidak terkirim.
ADMIN_CHAT_ID=

# ─── Telegram Admin Bot (BotFather) ─────────────────────────────────────────
# Token from @BotFather — lets you manage channels from Telegram:
#   /list  /info  /add  /stop  /resume  /remove  /sethls  /live  /status
# Create a bot: open @BotFather → /newbot → copy the token here.
# Then send /start to your bot from the admin account (ADMIN_CHAT_ID).
TELEGRAM_BOT_TOKEN=

# ─── Telegram Replay Bot (publik) ─────────────────────────────────────────
# Bot PUBLIK untuk fitur "Download via Bot Telegram" di halaman watch.
# Buat bot terpisah via @BotFather, lalu isi token & username-nya di sini.
TELEGRAM_REPLAY_BOT_TOKEN=
REPLAY_BOT_USERNAME=

# Channel Telegram PRIVAT sebagai database arsip video replay.
# Userbot Telethon harus jadi member, dan replay bot harus jadi admin di sini.
TELEGRAM_ARCHIVE_CHANNEL_ID=

# Upload rekaman live ke channel arsip Telegram selain YouTube (true/false).
# false (default) = rekaman live hanya diunggah ke YouTube.
# Upload arsip live ke Telegram tidak efektif: file 1-2 GB pecah jadi ribuan
# part 512 KiB, memicu FLOOD_PREMIUM_WAIT beruntun dan mengunci sesi di status
# 'pending_upload' berjam-jam. YouTube tetap sumber playback website, jadi
# mematikan tahap ini tidak menghapus apa pun dari situs.
# Arsip TikTok TIDAK terpengaruh flag ini.
TELEGRAM_ARCHIVE_UPLOAD_ENABLED=false

# Run the replay bot listener inside the main bot process (true/false)
REPLAY_BOT_ENABLED=true

# Extra admin chat IDs allowed to control the bot (comma separated).
# ADMIN_CHAT_ID is always allowed automatically.
# Minimal salah satu (ADMIN_CHAT_ID atau TELEGRAM_ADMIN_IDS) harus diisi;
# jika keduanya kosong, admin bot TIDAK dijalankan (fail-closed).
# TELEGRAM_ADMIN_IDS=

# Run the admin bot listener inside the main bot process (true/false)
ADMIN_BOT_ENABLED=true

# Notifikasi progres live (record / merge / upload) ke admin via Telegram.
# Dikirim ke ADMIN_CHAT_ID + TELEGRAM_ADMIN_IDS untuk setiap live IDN & Showroom:
#   REC MULAI/SELESAI/GAGAL → MERGE MULAI/SELESAI/GAGAL →
#   UPLOAD TELEGRAM & YOUTUBE (termasuk kuota habis / file hilang).
# Set false bila terlalu ramai; pipeline record/merge/upload tidak terpengaruh.
ADMIN_LIVE_NOTIFY_ENABLED=true

# ─── Legacy Upload Target (compatibility only) ───────────────────────────────
# Pipeline live mengikuti TELEGRAM_ARCHIVE_UPLOAD_ENABLED (arsip Telegram) +
# YouTubeChannelPool. Nilai di bawah hanya dibaca supaya .env lama tetap valid.
UPLOAD_TARGET=youtube

# Max video size in MB sebelum dipecah (default 1500).
# Batas riil per file ditentukan JUMLAH part: 4000 part × 512 KiB = 2.000 MiB
# untuk akun biasa, 8000 part ≈ 4 GiB dengan Premium (bot/telegram_limits.py).
# 1500 MiB = 3.000 part (75% jatah akun biasa) sehingga ~99% rekaman tetap satu
# pesan. Nilai di atas 1800 MB otomatis dijepit karena akun biasa tidak bisa
# mengirimnya.
# Menurunkan/menaikkan nilai ini TIDAK memperbaiki FLOOD_PREMIUM_WAIT_* —
# Telethon memecah file jadi ~512 KiB per request, jadi yang dibatasi Telegram
# adalah JUMLAH request (1.1 GB ≈ 2.267 request). Jawabannya ada di dua
# variabel di bawah.
TELEGRAM_MAX_FILE_SIZE_MB=1500

# Retry khusus flood (FLOOD_PREMIUM_WAIT_* / FloodWaitError) saat upload file
# besar. Jeda = PERSIS durasi yang diminta Telegram (FloodWaitError.seconds,
# atau angka di pesan untuk RPC 420) + jitter 0-30%. Upload dilanjutkan dari
# part terakhir (resume intra-file), jadi menunggu lebih lama dari penalti
# aslinya tidak menambah peluang berhasil. Setelah jatah retry habis, file TETAP
# disimpan di disk dan kembali ke antrean pada siklus retry berikutnya.
# Naikkan TELEGRAM_FLOOD_MAX_RETRIES bila antrean besar dan Anda rela
# satu file menunggu lebih lama (mis. 10 → ~1 jam untuk file paling besar).
TELEGRAM_FLOOD_MAX_RETRIES=6

# FLOOD_PREMIUM_WAIT_* = sinyal kuota lelah; angka di pesan (mis. 3 detik)
# bukan penalti sebenarnya, jadi tunggu jauh lebih lama.
TELEGRAM_FLOOD_PREMIUM_WAIT_SECONDS=900

# Diamkan file yang kehabisan jatah flood selama ini (menit).
TELEGRAM_FLOOD_COOLDOWN_MINUTES=90

# Setelah N kegagalan upload Telegram berturut-turut, bot BERHENTI mencoba
# arsip (telegram_gave_up) dan tidak akan dicoba lagi. File lokal tetap
# dihapus begitu YouTube selesai, sehingga tidak ada file 1-2 GB yang tertahan
# cuma karena channel arsip sedang bermasalah. Website tetap menayangkan video
# tanpa tombol download (tidak ada arsip untuk disalin).
TELEGRAM_UPLOAD_MAX_FAILURES=8

# ─── Anti-hang upload Telegram (detik) ───────────────────────────────────────
# Insiden 30 Sep 2026: notifikasi "UPLOAD TELEGRAM" terkirim, lalu tidak ada
# notifikasi apa pun selama 28 jam sementara video tidak pernah muncul di
# channel. Penyebabnya BUKAN flood: satu request Telethon menggantung (koneksi
# yang tidak maju) sehingga upload tidak pernah selesai maupun melempar error.
# Akibatnya baris DB terkunci di 'uploading_telegram' (tidak dibaca worker
# retry) dan lock upload membekukan notifikasi admin.
#
# Semua request kini dibungkus batas waktu keras: 300 detik tanpa respons saat
# mengirim part 512 KiB, 600 detik saat membuat pesan. Notifikasi teks punya
# batas sendiri (60 detik) dan TIDAK lagi menunggu lock upload, jadi status
# upload selalu bisa dikomunikasikan ke admin.
#
# TELEGRAM_UPLOAD_STALE_MINUTES: jaring pengaman terakhir. Upload yang masih
# berjalan di bawah ambang ini tidak akan disentuh recovery; yang melewati
# ambang dibatalkan lalu dikembalikan ke antrean retry. Harus jauh lebih besar
# dari durasi flood terpanjang (retry × FLOOD_PREMIUM_WAIT_SECONDS).
TELEGRAM_PART_UPLOAD_TIMEOUT_SECONDS=300
TELEGRAM_SEND_TIMEOUT_SECONDS=600
TELEGRAM_NOTIFY_TIMEOUT_SECONDS=60

# Jeda antar part saat upload (ms). Ukuran part Telethon 128-512 KiB
# tergantung ukuran file, jadi file 1 GB = 4.000-an request. Tanpa jeda bot
# memompa ~1,8 MB/s dan kena FLOOD_PREMIUM_WAIT 930-1042 detik setelah hanya
# ~20 MB (terukur 1 Okt 2026: 20 MB per 15 menit, padahal YouTube butuh 2m38s
# untuk file yang sama). Jeda 500 ms (~1 MB/s) jauh lebih murah: penalti 15
# menit per 20 MB mengalahkan transfer lambat yang terus berjalan.
# Naikkan hanya kalau account sudah rutin bebas FLOOD_PREMIUM_WAIT.
TELEGRAM_UPLOAD_PART_DELAY_MS=500

# Usia maksimum sidecar yang masih di-resume (jam; 0 = tanpa batas). Sesi
# upload besar di server TIDAK bertahan selamanya - Telegram membuang part yang
# belum dirakit. Sidecar basi yang di-resume hanya membuang bandwidth: file
# naik ke 100%, ditolak FILE_PART_MISSING, lalu diulang dari nol (terukur
# 1 Okt 2026: 528 MB terbuang sia-sia). Resume tetap berguna untuk jeda singkat
# (flood, restart bot) yang justru kasus resume yang sesungguhnya.
TELEGRAM_UPLOAD_RESUME_MAX_AGE_HOURS=12
TELEGRAM_UPLOAD_STALE_MINUTES=90

# ─── YouTube Multi-Channel Pool ─────────────────────────────────────────────
# Channel 1 (Primary)
YT_CHANNEL_1_LABEL=Channel Utama
YT_CHANNEL_1_TOKEN=youtube_token.json
YT_CHANNEL_1_SECRET=client_secret.json

# Channel 2 (Backup - uncomment and add if you want multi-channel quota distribution)
# YT_CHANNEL_2_LABEL=Channel Backup
# YT_CHANNEL_2_TOKEN=youtube_token_ch2.json
# YT_CHANNEL_2_SECRET=client_secret_ch2.json

# Your website player base URL — DIHAPUS.
# Fitur tautan "Watch on Web" pada notifikasi Telegram sudah dihilangkan, jadi
# variabel YOUTUBE_PLAYER_BASE_URL tidak lagi dibaca. Notifikasi Telegram kini
# hanya memuat tautan YouTube.

# ─── Zona Waktu ─────────────────────────────────────────────────────────────
# Waktu SELALU disimpan sebagai UTC (dengan penanda zona waktu), sehingga nilai
# di database sama di server mana pun — termasuk VPS Seoul (UTC+9).
# Variabel di bawah hanya mengatur TAMPILAN: caption Telegram, judul/deskripsi
# YouTube, dan log status.
#
# Offset zona waktu penonton terhadap UTC: 7 = WIB, 8 = WITA, 9 = WIT.
DISPLAY_TIMEZONE_OFFSET_HOURS=7
DISPLAY_TIMEZONE_LABEL=WIB

# HANYA untuk baris database LAMA yang waktunya belum punya penanda zona waktu.
# Nilai naif dianggap UTC kecuali offset di sini diisi dengan offset server lama
# (mis. 8 bila server lama memakai WITA). Baris baru selalu UTC sehingga
# pengaturan ini tidak memengaruhinya.
LEGACY_NAIVE_TIME_OFFSET_HOURS=0

# ─── Bot Behaviour ──────────────────────────────────────────────────────────
# Path to file containing specific member usernames to monitor (one per line)
MEMBERS_FILE=members.txt

# How often to check HLS stream status (seconds)
HLS_CHECK_INTERVAL_SECONDS=15

# How long to wait after live disconnects for reconnection before merging & uploading (seconds)
# Default: 3600 (1 hour) — batas ATAS; upload bisa lebih cepat lewat idle/IDN di bawah
MERGE_WINDOW_SECONDS=3600

# Finalize lebih cepat bila HLS sudah offline & idle selama N detik.
# 0 (DEFAULT) = nonaktif — selalu tunggu MERGE_WINDOW_SECONDS penuh.
#
# ️ JANGAN dinaikkan tanpa alasan: bukti nyata live jkt48_daisy (13 Sep 2026)
# menunjukkan reconnect BISA lebih dari 50 menit:
#   haii-260913192155 (19:21) -> haii-260913201248 (20:12) -> haii-260913201503 (20:15)
# Kalau ambang ini lebih kecil dari jeda reconnect terpanjang, SATU live akan
# terpecah menjadi beberapa video.
MERGE_IDLE_FINALIZE_SECONDS=0

# Pisahkan video bila JUDUL live berubah (indikasi live baru).
# DEFAULT false = NONAKTIF, dan itu yang direkomendasikan:
#   - jkt48_carissa (15 Sep 2026) mengedit JUDUL 3x dalam satu live (4 slug, jeda 1-8
#     menit) → kalau fitur ini aktif, satu live jadi 3 video.
#   - jkt48_daisy (13 Sep 2026) reconnect dengan JUDUL SAMA tapi slug baru (jeda 51 menit).
# Jadi slug maupun judul BUKAN penentu "live baru"; penentu andal = jeda waktu
# (MERGE_WINDOW_SECONDS). Aktifkan hanya kalau Anda yakin member tidak pernah
# mengedit judul di tengah live.
MERGE_SPLIT_ON_TITLE_CHANGE=false

# Hard cap: finalize paksa merge group setelah N jam (anti stream "hang" tanpa disconnect)
MERGE_MAX_GROUP_HOURS=6


# ----- Showroom (OPSIONAL, default NONAKTIF) -----
# Selama SHOWROOM_ENABLED=false, bot berjalan PERSIS seperti sebelumnya (jalur
# Showroom tidak pernah dijalankan). Aktifkan hanya setelah Fase 2 selesai dan
# room sudah di-seed: python3 -m bot.seed_showroom
SHOWROOM_ENABLED=false

# Interval probe Showroom dipisah dari HLS_CHECK_INTERVAL_SECONDS (5 detik) untuk
# menghindari rate-limit API Showroom. 30 detik masih jauh lebih cepat daripada
# durasi live.
SHOWROOM_CHECK_INTERVAL_SECONDS=30
SHOWROOM_CONCURRENCY=10
SHOWROOM_TIMEOUT_SECONDS=8

# Berapa pembacaan offline BERTURUT-TURUT sebelum sinyal offline dianggap sah.
# Hanya memperlambat finalisasi, tidak pernah mempercepat.
SHOWROOM_OFFLINE_CONFIRMATIONS=3

# Sumber daftar room untuk seed.
SHOWROOM_ROOMS_FILE=showroom_rooms.json

# ─── Arsip TikTok (OPSIONAL, default NONAKTIF) ──────────────────────────────
# Memantau akun TikTok member tanpa login: postingan (video & FOTO) + story.
# Video/foto dikirim ke channel arsip Telegram dan diunggah ke YouTube
# (postingan foto dirangkai menjadi slide show). Halaman publik: /tiktok.
#
# Urutan menyalakan:
#   1) python3 -m bot.jkt48_members --update   (roster resmi: peta akun + foto)
#   2) python3 -m bot.seed_tiktok --dry-run    (lihat rencana & pencocokan member)
#   3) python3 -m bot.seed_tiktok
#   4) TIKTOK_ENABLED=true
#   5) pm2 restart jkt48-archiver-bot --update-env
TIKTOK_ENABLED=false

# Penyedia data: "auto" (tikwm → embed → yt-dlp), "tikwm", "embed", "ytdlp",
# atau "fixture" (baca JSON lokal — untuk uji tanpa jaringan).
#  - tikwm : JSON paling lengkap; satu-satunya yang mendukung STORY
#            (`/api/user/story`, path TUNGGAL). Cloudflare bisa memblokir
#            `/api/user/posts` (403) untuk sebagian IP.
#  - embed : halaman embed TikTok (10 post terbaru, foto dideteksi dari
#            ketiadaan playAddr) — paling andal untuk listing, tanpa story.
#  - ytdlp : tanpa pihak ketiga; listing profil butuh secUid.
TIKTOK_PROVIDER=auto

# Profil impersonasi TLS curl_cffi. Cloudflare di tikwm.com & halaman TikTok
# menjawab 403 pada request biasa; fingerprint browser ini menembusnya.
TIKTOK_IMPERSONATE=chrome131

# Jeda tikwm saat kena rate-limit per detik / kuota harian (gratis ±10.000/hari).
TIKWM_RATE_COOLDOWN_SECONDS=5
TIKWM_QUOTA_COOLDOWN_SECONDS=1800

# Satu siklus memeriksa SATU akun (round-robin) agar tidak menabrak batas request.
TIKTOK_CHECK_INTERVAL_SECONDS=300

# Jeda minimum antar request ke sumber data (detik). 1.1 = aman untuk tikwm.
TIKTOK_REQUEST_INTERVAL_SECONDS=1.1

# Ambil story juga? (story hilang setelah ±24 jam di TikTok)
TIKTOK_STORIES_ENABLED=true

# Unggah juga ke YouTube? Bila false, arsip hanya masuk channel Telegram.
TIKTOK_YT_UPLOAD_ENABLED=true

# Kirim media TikTok (foto/video/story) ke channel arsip Telegram.
# TERPISAH dari TELEGRAM_ARCHIVE_UPLOAD_ENABLED yang hanya untuk rekaman live
# IDN/Showroom. Arsip TikTok tetap aktif karena medianya kecil (foto 200-900 KB)
# sehingga tidak pernah jadi bottleneck seperti file rekaman live 1-2 GB.
TIKTOK_ARCHIVE_UPLOAD_ENABLED=true

# Kirim foto TikTok sebagai FILE (document), bukan foto inline.
# Telegram memakai WebP sebagai format STIKER resmi: foto WebP yang diunggah
# tanpa paksaan document tampil sebagai stiker dan user TIDAK bisa
# mengunduhnya. true membuat foto tiba sebagai berkas JPEG/PNG biasa yang
# selalu bisa diunduh apa adanya.
TIKTOK_PHOTOS_AS_DOCUMENT=true

# Maksimum foto per album Telegram (batas Telegram = 10). Postingan dengan lebih
# banyak foto otomatis dikirim sebagai beberapa part.
TIKTOK_PHOTOS_PER_PART=10

# Lama tiap foto tampil di slide show YouTube (detik).
TIKTOK_SLIDESHOW_SECONDS_PER_PHOTO=3

# Batas jumlah postingan baru per siklus (anti-banjir saat akun baru dipantau).
TIKTOK_MAX_POSTS_PER_CHECK=10

# Jangan proses story lebih tua dari N jam.
TIKTOK_STORY_MAX_AGE_HOURS=24

# Sumber daftar akun & folder fixture (untuk TIKTOK_PROVIDER=fixture).
TIKTOK_ACCOUNTS_FILE=tiktok_accounts.json
TIKTOK_FIXTURE_DIR=tests/fixtures/tiktok

# Daftar member resmi JKT48 dari jkt48.com/api/v1 (cache JSON). Dipakai seed
# sebagai sumber OTORITATIF pemetaan akun TikTok → member (field tiktok_account,
# mis. jkt48.aurellia_ → jkt48_lia) dan foto member di sidebar /tiktok.
# Perbarui bila ada member baru / akun TikTok berubah:
#   python3 -m bot.jkt48_members --update     (58 request, ±0,35 dtk jeda)
# Tidak wajib: bila berkasnya tidak ada, seed tetap jalan dengan pencocokan nama.
JKT48_MEMBERS_FILE=jkt48_members.json

# Jeda antar-request saat menarik roster resmi (detik).
JKT48_MEMBERS_INTERVAL_SECONDS=0.35

# ----- Catatan untuk website (web/.env) -----
# NEXT_PUBLIC_REPLAY_BOT_USERNAME=<username bot tanpa @>
# Wajib diisi agar tombol "Download via Bot Telegram" di halaman /tiktok dan
# /watch membentuk deep-link yang benar (arsip TikTok memakai payload tt_<id>).


# web/.env punya DB_PATH sendiri dan WAJIB absolut, mis.
#   DB_PATH=/home/USER/jkt48-live/jkt48_live.db
# supaya bot dan web memakai berkas database yang SAMA. Bila berbeda, website
# akan tampak kosong tanpa pesan error apa pun.
# Lihat deploy/README.md untuk langkah deploy domain.

# Interval pengecekan ulang ketika finalize ditunda (mis. member masih live)
MERGE_DEFER_SECONDS=300

# ─── IDN Lookup (OPSIONAL) ──────────────────────────────────────────────────
# Dipakai hanya untuk membedakan "reconnect" vs "live baru" (butuh slug sesi IDN)
# dan mengambil judul live. Bot tetap berfungsi penuh dengan HLS saja.
# Set false kalau server IDN sedang bermasalah (banyak member live / server down).
IDN_LOOKUP_ENABLED=true
IDN_LOOKUP_TIMEOUT_SECONDS=8
IDN_LOOKUP_CACHE_SECONDS=30

# Waktu maksimal menunggu rekaman aktif selesai saat bot dihentikan (pm2 restart)
# supaya segmen parsial tidak hilang.
GRACEFUL_SHUTDOWN_SECONDS=25

# Local directory for temporary video storage on VPS
DOWNLOAD_DIR=/tmp/jkt48-lives

# Ruang disk minimum (MB) sebelum bot mulai recording baru.
# Di bawah ambang ini live terdeteksi tetapi TIDAK direkam (warning di log).
MIN_FREE_DISK_MB=2048

# ─── Reclaim disk otomatis (default true) ────────────────────────────────
# Rekaman yang upload-nya gagal permanen (dead-letter) tidak pernah dihapus
# oleh pipeline: AUTO_DELETE_AFTER_UPLOAD hanya menghapus setelah upload
# BERHASIL. Ditambah antrean pending_upload di-retry tanpa batas umur dan
# `bot.status --cleanup` sengaja mengecualikannya, jadi file 1-2 GB menumpuk
# selamanya. Begitu ruang bebas < MIN_FREE_DISK_MB, disk guard memblokir SEMUA
# rekaman (IDN + Showroom) - gejala luarnya "bot kadang merekam, kadang tidak,
# bahkan tidak bisa mendeteksi member live".
#
# true = bot menghapus otomatis file yang statusnya sudah terminal
#        (failed/abandoned/done_*) dan tidak dirujuk baris lain yang aktif.
#        pending_upload yang masih bisa dicoba TIDAK ikut dihapus.
# Cek ukuran sisa dengan: python3 -m bot.disk_reclaim --dry-run
DISK_RECLAIM_ENABLED=true

# Umur minimum (jam) sebelum file terminal boleh dihapus otomatis, supaya sesi
# yang baru saja gagal masih punya kesempatan retry biasa.
DISK_RECLAIM_MIN_AGE_HOURS=6

# Seberapa sering (menit) reclaim dijalankan.
DISK_RECLAIM_INTERVAL_MINUTES=30

# Jumlah file maksimum per satu kali reclaim (batas waktu eksekusi).
DISK_RECLAIM_MAX_FILES=200

# Setelah N kegagalan upload YouTube berturut-turut, sesi di-dead-letter jadi
# 'failed' supaya file-nya bisa direclaim. Tanpa batas ini, kuota harian yang
# habis membuat file 1-2 GB retry selamanya dan tidak pernah terhapus.
YOUTUBE_UPLOAD_MAX_FAILURES=6

# SQLite database file path
DB_PATH=jkt48_live.db

# Delete local file from VPS after successful upload? (true/false)
AUTO_DELETE_AFTER_UPLOAD=true

# Thumbnail kolase 3x2 untuk video BARU (true/false). Dibuat dari file lokal
# via ffmpeg lalu dipasang ke YouTube (~50 unit kuota). Gagal membuat /
# memasang thumbnail TIDAK menggagalkan upload. Video lama tak disentuh.
# Butuh ffmpeg + ffprobe terpasang di VPS maupun lokal (untuk uji).
THUMBNAIL_COLLAGE_ENABLED=true
